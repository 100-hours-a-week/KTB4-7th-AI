# 로컬 개발용 값만 작성한다. 실제 비밀번호·API 키·AWS 자격 증명은 넣지 않는다.

# LLM provider 선택: anthropic | openai | google | upstage
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5

# provider별 API 키 — 실제로 쓰는 provider의 키만 채우면 된다
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
UPSTAGE_API_KEY=up_...

# OpenAI 호환 서버(vLLM 등)로 돌릴 때만 채운다. 비우면 OpenAI 공식 엔드포인트를 쓴다.
# 로컬 LLM 검증용 — RunPod 등에 띄운 vLLM 의 /v1 주소. LLM_PROVIDER=openai 로 둔다.
# 이 값이 있으면 OPENAI_API_KEY 가 없어도 기동한다(vLLM 은 기본적으로 인증을 안 건다).
# LLM_BASE_URL=http://10.0.1.9:8000/v1
# LLM_MODEL=Qwen/Qwen3-14B-AWQ

# Qwen3 계열은 vLLM 에서 thinking 이 기본으로 켜져 있다. <think> 블록이 본문 앞에 붙어
# JSON 파싱이 전부 깨지므로 로컬 Qwen3 를 쓸 때는 true 로 둔다.
# LLM_DISABLE_THINKING=false

# Backend 분석 모듈 (챗봇 툴 6종 호출 대상)
# 로컬 개발은 devtools/stub_backend.py 를 띄우고 9000 사용
BACKEND_BASE_URL=http://localhost:9000
